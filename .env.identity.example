# Identity + payments settings for api.py. Add these to your .env (it already holds the AI keys).

# Who is calling: identity's public key (default: ../identity/.dev-keys/identity_ed25519.pub.pem)
# IDENTITY_PUBLIC_KEY_PATH=../identity/.dev-keys/identity_ed25519.pub.pem
IDENTITY_ALLOWED_ORIGINS=http://localhost:5291
# Where vvc_identity.py lives (default: ../identity/client/python)
# VVC_IDENTITY_CLIENT_DIR=../identity/client/python

# Same value as memestudio-backend's: credit tokens it signs are accepted here. Unset = credits off.
# CREDIT_SHARED_SECRET=

# Same value as memestudio-backend's: every USDC tx is claimed in its suite-wide ledger so one
# payment can't buy twice. Unset (or memestudio unreachable) = USDC payments refused with 503.
# VVC_INTERNAL_SECRET=
# Where memestudio-backend listens (default: http://127.0.0.1:3016)
# MEMOSTUDIO_INTERNAL_URL=http://127.0.0.1:3016

# Only if a tool on another origin (e.g. ui/ on its own port) must call the API
# MF_CORS_ORIGINS=http://localhost:8001

# Data (default: memes.db next to api.py)
# MF_DB_PATH=./memes.db
